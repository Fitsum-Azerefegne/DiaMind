# Backend environment variables
# Copy this file to .env for local development.

# Database connection for FastAPI / SQLAlchemy.
# Local SQLite default (works without extra setup):
DATABASE_URL=sqlite:///./diamind.db

# Google OAuth client ID for the backend token verification.
# Replace with your real Google OAuth Client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=

# Allowed frontend origins for CORS.
# Comma-separated list, e.g. http://localhost:5173,http://127.0.0.1:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend environment variables
# Put these in frontend/.env.local for local development if you want to override the defaults.

# Vite public API base URL.
# Leave blank to use same-origin in production, or set to your backend URL locally.
VITE_API_BASE=

# Google OAuth client ID for the frontend Google sign-in button.
# Use the same Google OAuth Client ID as above.
VITE_GOOGLE_CLIENT_ID=
